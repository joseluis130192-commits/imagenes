# Copiá este archivo como .env.local y completá los valores reales.

# Key de OpenAI. Queda solo en el servidor: nunca llega al navegador.
OPENAI_API_KEY=sk-proj-pega-aca-tu-key

# URL del proyecto de Supabase (Project Settings → API).
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service role key de Supabase (Project Settings → API). Da acceso total: nunca la
# expongas al cliente, solo se usa desde las API routes.
SUPABASE_SERVICE_ROLE_KEY=pega-aca-la-service-role-key

# Contraseña de acceso al panel. La elegís vos.
CLAVE_ACCESO=pone-aca-una-clave

# Key de Kie AI (kie.ai), para los modelos de Flux-2 Pro y Nano Banana 2 del market.
# Se saca del dashboard de Kie. Igual que la de OpenAI, solo se usa en el servidor.
KIE_API_KEY=pega-aca-tu-kie-api-key
